{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{minimum_otp_vsn, "21.3"}.

{profiles, [
    {test, [
        {deps, [
            {proper, "1.5.0"},
            {cowlib, "2.21.0"}
        ]},
        {erl_opts, [nowarn_export_all]}
    ]},
    {bench, [
        {deps, [
            {erlperf, "2.3.0"},
            {cowboy, "2.20.0"}
        ]},
        {extra_src_dirs, [{"bench", [{recursive, false}]}]}
    ]}
]}.

{proper_opts, [{numtests, 1000}]}.

{dialyzer, [
    {warnings, [unknown, unmatched_returns, error_handling]},
    {plt_extra_apps, [erts, kernel, stdlib]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{project_plugins, [
    {rebar3_proper, "0.12.1"},
    {rebar3_ex_doc, "0.3.0"},
    {rebar3_hex, "7.3.0"},
    {erlfmt, "1.8.0"}
]}.

{erlfmt, [
    write,
    {files, ["{src,test,bench}/*.{erl,hrl,app.src}", "rebar.config"]}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{ex_doc, [
    {main, "readme"},
    {source_url, "https://github.com/ninefx/gnomon"},
    {extras, [
        {"README.md", #{title => "Overview"}},
        {"CHANGELOG.md", #{title => "Changelog"}},
        {"LICENSE.md", #{title => "License"}}
    ]}
]}.
