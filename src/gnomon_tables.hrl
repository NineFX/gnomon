%% Literal lookup tables for gnomon's read path. This is fixed calendar
%% data; gnomon_tests checks every entry against its formula.
%%
%% Each macro expands to a literal tuple of integers. An entry is the
%% big-endian integer value of one field's ASCII bytes with its separator,
%% written in hex so each byte pair reads as a character code:
%% 16#4D6F6E2C20 is "Mon, ". gnomon:date/0 assembles its 29-byte binary
%% from seven of them as fixed-width integer segments.
%%
%%   WDAYS_INT     7 entries of 40 bits, Monday first, index = weekday + 1
%%   MDAYS_INT    31 entries of 24 bits, index = day of month
%%   MONTHS_INT   12 entries of 32 bits, index = month
%%   YEARS_INT   200 entries of 40 bits for 2000-2199, index = year - 1999
%%   HOURS_INT     the first 24 entries of MINUTES_INT, index = hour + 1
%%   MINUTES_INT  60 entries of 24 bits, index = minute + 1
%%   SECONDS_INT  60 entries of 48 bits, index = second + 1

-define(WDAYS_INT,
    {16#4D6F6E2C20, 16#5475652C20, 16#5765642C20, 16#5468752C20, 16#4672692C20, 16#5361742C20,
        16#53756E2C20}
).

